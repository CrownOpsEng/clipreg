<protocol name="clipreg_cosmic_toplevel_v1">
  <!-- Opaque v1 workspace object referenced by workspace_enter/leave. -->
  <interface name="zcosmic_workspace_handle_v1" version="1"/>

  <interface name="zcosmic_toplevel_info_v1" version="1">
    <event name="toplevel">
      <arg name="toplevel" type="new_id" interface="zcosmic_toplevel_handle_v1"/>
    </event>
    <request name="stop"/>
    <event name="finished"/>
  </interface>

  <interface name="zcosmic_toplevel_handle_v1" version="1">
    <request name="destroy" type="destructor"/>
    <event name="closed"/>
    <event name="done"/>
    <event name="title"><arg name="title" type="string"/></event>
    <event name="app_id"><arg name="app_id" type="string"/></event>
    <event name="output_enter"><arg name="output" type="object" interface="wl_output"/></event>
    <event name="output_leave"><arg name="output" type="object" interface="wl_output"/></event>
    <event name="workspace_enter"><arg name="workspace" type="object" interface="zcosmic_workspace_handle_v1"/></event>
    <event name="workspace_leave"><arg name="workspace" type="object" interface="zcosmic_workspace_handle_v1"/></event>
    <enum name="state">
      <entry name="maximized" value="0"/>
      <entry name="minimized" value="1"/>
      <entry name="activated" value="2"/>
      <entry name="fullscreen" value="3"/>
    </enum>
    <event name="state"><arg name="state" type="array"/></event>
  </interface>
</protocol>
