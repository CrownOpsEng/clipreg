#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-only
set -euo pipefail

CLIPREG_VERSION="0.1.0"

TAB="Clipboard Registers"
MARKER_MIME="application/x-crownops-clipreg-key"
RESTORE_DELAY="${CLIPREG_RESTORE_DELAY:-0.75}"
SETTLE_DELAY="${CLIPREG_SETTLE_DELAY:-0.05}"
LOCK_FILE="${XDG_RUNTIME_DIR:-/tmp}/clipreg-${UID}.lock"

usage() {
    cat <<'USAGE'
Usage:
  clipreg save KEY     Save the current clipboard into register KEY.
  clipreg paste KEY    Paste register KEY; text is typed directly, rich data is
                       pasted through a temporary clipboard swap and restored.
  clipreg type KEY     Type the text/plain representation without touching clipboard.
  clipreg copy KEY     Put register KEY onto the real clipboard.
  clipreg show KEY     Print register text or its MIME formats.
  clipreg clear KEY    Delete register KEY.
  clipreg list         List saved registers.
  clipreg doctor       Check required tools and runtime state.

KEY may be 0-9 or F1-F12.

Environment:
  CLIPREG_RESTORE_DELAY  Seconds to wait after rich Ctrl+V before restoring
                         the previous clipboard (default: 0.75).
  CLIPREG_SETTLE_DELAY   Seconds to wait after staging rich clipboard data
                         before Ctrl+V (default: 0.05).

Security:
  Clipboard content marked secret by a password manager is refused rather than
  persisted in the CopyQ Registers tab.
USAGE
}

die() {
    printf 'clipreg: %s\n' "$*" >&2
    exit 1
}

need() {
    command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

normalize_key() {
    local key="${1:-}"
    key="${key^^}"
    case "$key" in
        [0-9]|F[1-9]|F1[0-2]) printf '%s\n' "$key" ;;
        *) die "invalid key '$key' (expected 0-9 or F1-F12)" ;;
    esac
}

ensure_copyq() {
    need copyq
    copyq --start-server tab >/dev/null 2>&1 || die "could not start/connect to CopyQ"
}

ensure_tab() {
    if ! copyq tab 2>/dev/null | sed 's/^&//' | grep -Fxq "$TAB"; then
        copyq tab "$TAB" add -- '__clipreg_init__' >/dev/null
        copyq tab "$TAB" remove 0 >/dev/null
    fi
}

lock() {
    need flock
    exec 9>"$LOCK_FILE"
    flock -w 2 9 || die "another clipboard-register operation is still running"
}

COMMON_JS=$(cat <<'JS'
var TAB = "Clipboard Registers";
var MARKER = "application/x-crownops-clipreg-key";
var NOTE = "application/x-copyq-item-notes";

function clipboardLooksSecret() {
    var formats = str(clipboard("?")).split(/\r?\n/);
    for (var i = 0; i < formats.length; ++i) {
        var format = formats[i];
        if (!format)
            continue;
        var lower = format.toLowerCase();
        if (lower === "application/x-copyq-secret")
            return true;
        if (lower === "x-kde-passwordmanagerhint") {
            try {
                if (str(clipboard(format)).toLowerCase().trim() === "secret")
                    return true;
            } catch (e) {}
        }
    }
    return false;
}

function captureClipboardItem() {
    var result = {};
    var formats = str(clipboard("?")).split(/\r?\n/);
    for (var i = 0; i < formats.length; ++i) {
        var format = formats[i];
        if (!format)
            continue;
        try {
            result[format] = clipboard(format);
        } catch (e) {
            // A clipboard owner can withdraw a format between enumeration/read.
        }
    }
    return result;
}

function isInternalFormat(format) {
    return format === MARKER || format.indexOf("application/x-copyq-") === 0;
}

function externalItem(item) {
    var result = {};
    for (var format in item) {
        if (!isInternalFormat(format))
            result[format] = item[format];
    }
    return result;
}

function externalFormatCount(item) {
    var count = 0;
    for (var format in item) {
        if (!isInternalFormat(format))
            ++count;
    }
    return count;
}

function findRegisterRow(key) {
    tab(TAB);
    for (var row = 0; row < size(); ++row) {
        var item = getItem(row);
        if (item[MARKER] !== undefined && str(item[MARKER]) === key)
            return row;
    }
    return -1;
}

function getRegister(key) {
    var row = findRegisterRow(key);
    if (row < 0)
        fail();
    return getItem(row);
}

function isPlainTextItem(item) {
    var foundText = false;
    for (var format in item) {
        if (isInternalFormat(format))
            continue;

        var lower = format.toLowerCase();
        if (lower === "text/plain" || lower.indexOf("text/plain;") === 0 ||
            lower === "utf8_string" || lower === "string" || lower === "text") {
            foundText = true;
            continue;
        }
        return false;
    }
    return foundText;
}

function plainText(item) {
    if (item[mimeText] !== undefined)
        return item[mimeText];

    for (var format in item) {
        if (format.toLowerCase().indexOf("text/plain;") === 0)
            return item[format];
    }
    fail();
}
JS
)

save_register() {
    local key="$1"
    copyq eval -- "$COMMON_JS
var KEY = str(arguments[1]);
if (clipboardLooksSecret())
    fail();
var item = externalItem(captureClipboardItem());
if (externalFormatCount(item) === 0)
    fail();
item[MARKER] = KEY;
item[NOTE] = 'Register ' + KEY;
var row = findRegisterRow(KEY);
if (row >= 0) {
    remove(row);
    insert(row, item);
} else {
    add(item);
}
print('saved');
" "$key" >/dev/null || die "could not save clipboard into register $key"
    printf 'Saved clipboard -> register %s\n' "$key"
}

classify_register() {
    local key="$1"
    copyq eval -- "$COMMON_JS
var KEY = str(arguments[1]);
var item = getRegister(KEY);
isPlainTextItem(item) ? 'text' : 'rich';
" "$key" 2>/dev/null | tr -d '\r\n'
}

type_register() {
    local key="$1"
    need wtype
    if ! copyq eval -- "$COMMON_JS
var KEY = str(arguments[1]);
var item = getRegister(KEY);
print(plainText(item));
" "$key" 2>/dev/null | wtype -; then
        die "register $key has no usable plain-text representation or wtype failed"
    fi
}

copy_register() {
    local key="$1"
    copyq eval -- "$COMMON_JS
var KEY = str(arguments[1]);
var item = externalItem(getRegister(KEY));
if (externalFormatCount(item) === 0)
    fail();
copy(item);
" "$key" >/dev/null || die "could not copy register $key to clipboard"
}

stage_rich_paste() {
    local key="$1"
    local token="$2"
    copyq eval -- "$COMMON_JS
var KEY = str(arguments[1]);
var TOKEN = str(arguments[2]);
var original = externalItem(captureClipboardItem());
original[MARKER] = '__restore__:' + TOKEN;
original[NOTE] = 'Temporary clipboard restore';
tab(TAB);
add(original);
var item = externalItem(getRegister(KEY));
if (externalFormatCount(item) === 0)
    fail();
copy(item);
" "$key" "$token" >/dev/null || die "could not stage rich register $key"
}

restore_clipboard() {
    local token="$1"
    copyq eval -- "$COMMON_JS
var TOKEN = str(arguments[1]);
var row = findRegisterRow('__restore__:' + TOKEN);
if (row < 0)
    fail();
var item = externalItem(getItem(row));
remove(row);
if (externalFormatCount(item) === 0)
    copy('');
else
    copy(item);
" "$token" >/dev/null
}

paste_register() {
    local key="$1"
    local kind
    kind="$(classify_register "$key")" || true

    case "$kind" in
        text)
            type_register "$key"
            ;;
        rich)
            need wtype
            local token="${UID}-$$-$(date +%s%N)"
            local restore_needed=0

            stage_rich_paste "$key" "$token"
            restore_needed=1

            cleanup_rich() {
                if (( restore_needed )); then
                    restore_clipboard "$token" >/dev/null 2>&1 || true
                fi
            }
            trap cleanup_rich EXIT
            trap 'exit 130' INT
            trap 'exit 143' TERM

            sleep "$SETTLE_DELAY"
            wtype -M ctrl v -m ctrl
            sleep "$RESTORE_DELAY"
            restore_clipboard "$token" || die "paste succeeded, but clipboard restoration failed"
            restore_needed=0
            trap - EXIT INT TERM
            ;;
        *)
            die "register $key is empty or unreadable"
            ;;
    esac
}

show_register() {
    local key="$1"
    copyq eval -- "$COMMON_JS
var KEY = str(arguments[1]);
var item = getRegister(KEY);
try {
    print(plainText(item));
} catch (e) {
    for (var format in item) {
        if (!isInternalFormat(format))
            print(format + '\n');
    }
}
" "$key" || die "register $key is empty"
}

clear_register() {
    local key="$1"
    copyq eval -- "$COMMON_JS
var KEY = str(arguments[1]);
var row = findRegisterRow(KEY);
if (row < 0)
    fail();
remove(row);
" "$key" >/dev/null || die "register $key is already empty"
    printf 'Cleared register %s\n' "$key"
}

list_registers() {
    copyq eval -- "$COMMON_JS
var rows = [];
tab(TAB);
for (var row = 0; row < size(); ++row) {
    var item = getItem(row);
    if (item[MARKER] === undefined)
        continue;
    var key = str(item[MARKER]);
    if (key.indexOf('__restore__:') === 0)
        continue;
    var preview = '';
    try {
        preview = str(plainText(item)).replace(/[\r\n\t]+/g, ' ');
        if (preview.length > 72)
            preview = preview.substring(0, 69) + '...';
    } catch (e) {
        preview = '[rich/non-text]';
    }
    rows.push(key + '\t' + preview);
}
rows.sort();
for (var i = 0; i < rows.length; ++i)
    print(rows[i] + '\n');
" || die "could not list registers"
}

doctor() {
    local status=0
    printf 'clipreg doctor\n'
    for cmd in copyq wtype flock; do
        if command -v "$cmd" >/dev/null 2>&1; then
            printf '  OK      %-8s %s\n' "$cmd" "$(command -v "$cmd")"
        else
            printf '  MISSING %-8s\n' "$cmd"
            status=1
        fi
    done

    if command -v copyq >/dev/null 2>&1; then
        printf '  CopyQ   %s\n' "$(copyq --version 2>/dev/null | head -n1 || true)"
        if copyq --start-server tab >/dev/null 2>&1; then
            printf '  OK      CopyQ server reachable\n'
        else
            printf '  FAIL    CopyQ server unavailable\n'
            status=1
        fi
    fi

    if [ "${XDG_SESSION_TYPE:-}" = "wayland" ]; then
        printf '  OK      session=wayland\n'
    else
        printf '  INFO    session=%s (designed for COSMIC/Wayland)\n' "${XDG_SESSION_TYPE:-unknown}"
    fi

    local shortcuts="$HOME/.config/cosmic/com.system76.CosmicSettings.Shortcuts/v1/custom"
    if [ -f "$shortcuts" ] && grep -q '// CLIPREG-START' "$shortcuts"; then
        printf '  OK      COSMIC clipboard-register bindings installed\n'
    else
        printf '  INFO    COSMIC clipboard-register bindings not detected\n'
    fi

    return "$status"
}

main() {
    local command="${1:-}"
    case "$command" in
        -h|--help|help|'') usage; exit 0 ;;
        -V|--version|version) printf '%s\n' "$CLIPREG_VERSION"; exit 0 ;;
        doctor) doctor; exit $? ;;
    esac

    ensure_copyq
    lock
    ensure_tab

    case "$command" in
        save)
            [ "$#" -eq 2 ] || die "save requires KEY"
            save_register "$(normalize_key "$2")"
            ;;
        paste)
            [ "$#" -eq 2 ] || die "paste requires KEY"
            paste_register "$(normalize_key "$2")"
            ;;
        type)
            [ "$#" -eq 2 ] || die "type requires KEY"
            type_register "$(normalize_key "$2")"
            ;;
        copy)
            [ "$#" -eq 2 ] || die "copy requires KEY"
            copy_register "$(normalize_key "$2")"
            ;;
        show)
            [ "$#" -eq 2 ] || die "show requires KEY"
            show_register "$(normalize_key "$2")"
            ;;
        clear)
            [ "$#" -eq 2 ] || die "clear requires KEY"
            clear_register "$(normalize_key "$2")"
            ;;
        list)
            [ "$#" -eq 1 ] || die "list takes no KEY"
            list_registers
            ;;
        *)
            usage >&2
            die "unknown command '$command'"
            ;;
    esac
}

main "$@"
