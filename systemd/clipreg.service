[Unit]
Description=ClipReg transactional clipboard register service
Documentation=https://github.com/CrownOpsEng/clipreg
PartOf=cosmic-session.target
After=cosmic-session-pre.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=%h/.local/bin/clipreg daemon
Restart=on-failure
RestartSec=1

[Install]
WantedBy=cosmic-session.target
